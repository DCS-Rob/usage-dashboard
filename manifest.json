{
  "manifest_version": 3,
  "name": "Usage Dashboard - LLM Scraper",
  "version": "0.6.0",
  "description": "Monitort en synchroniseert automatisch je Claude Pro en ChatGPT Business usage en rolling limieten.",
  "permissions": [
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "*://*.claude.ai/*",
    "*://*.chatgpt.com/*",
    "*://gemini.google.com/*",
    "https://api.npoint.io/*",
    "https://www.npoint.io/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.claude.ai/*",
        "*://*.chatgpt.com/*",
        "*://gemini.google.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_title": "Open Usage Dashboard"
  }
}
